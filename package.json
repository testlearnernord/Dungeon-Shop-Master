{
  "name": "dungeon-shop-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/asset_generation/merge_tripo_grab_throw.mjs && node tools/asset_generation/consolidate_tripo_ghoul.mjs public/assets/models/dungeon-ghoul-tripo.glb",
    "dev": "vite",
    "prebuild": "node tools/asset_generation/merge_tripo_grab_throw.mjs && node tools/asset_generation/consolidate_tripo_ghoul.mjs public/assets/models/dungeon-ghoul-tripo.glb",
    "build": "tsc -b && vite build",
    "test": "playwright test",
    "test:smoke": "playwright test tests/cashierReceipt.spec.ts tests/shopTrafficReload.spec.ts tests/liveDungeonClock.spec.ts tests/liveCombatArena.spec.ts tests/liveFloorSpectator.spec.ts tests/heroBuyback.spec.ts --grep @ci-smoke",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "preview": "vite preview",
    "audit:modules": "node tools/maintenance/module_graph.mjs",
    "verify:pages": "node tools/maintenance/verify_pages_dist.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.31.0",
    "@babylonjs/loaders": "9.32.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
